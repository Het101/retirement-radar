    "deprecation",
    "devops",
    "eks",
    "elasticache",
    "end-of-life",
    "kafka",
    "lambda",
    "msk",
    "opensearch",
    "rds",
    "redis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Het101/retirement-radar.git"
  },
  "homepage": "https://hetops.dev",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "author": "Het Patel (https://hetops.dev)",
  "bugs": "https://github.com/Het101/retirement-radar/issues"
}
