{
  "name": "retirement-radar",
  "version": "0.3.0",
  "description": "Read-only scan of your AWS account for EKS, RDS, ElastiCache, OpenSearch, MSK and Lambda versions near end of support.",
  "bin": {
    "retirement-radar": "src/cli.js"
  },
  "files": [
    "src",
    "retirements.yaml"
  ],
  "scripts": {
    "test": "node --test",
    "hooks": "git config core.hooksPath .githooks",
    "prepublishOnly": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
