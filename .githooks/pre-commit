#!/bin/sh
# Retirement Radar pre-commit. Turn it on once with `npm run hooks`
# (git config core.hooksPath .githooks). `git commit --no-verify` skips it,
# but CI runs the same checks, so skipping only moves the failure later.
set -e

fail() {
  echo ""
  echo "pre-commit: $1" >&2
  echo ""
  exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# --- 1. Credentials must never enter the history -----------------------------
# This tool runs against AWS accounts, so the dangerous paste is an AWS key in
# an example, a test fixture or an issue reproduction. After a push to a public
# repo it is too late: keys are scraped within minutes.

if echo "$staged" | grep -E '(^|/)\.env($|\.)' | grep -qvE '\.env\.(example|sample|template|dist)$'; then
  fail "refusing to commit a .env file. Use .env.example with placeholders."
fi

added=$(git diff --cached --unified=0 -- $(echo "$staged" | tr '\n' ' ') 2>/dev/null | grep '^+' || true)

# Match the SHAPE of a real secret, not an allowlist of placeholders. AKIA... is
# a long-term access key id, ASIA... a temporary one.
if echo "$added" | grep -qE '(A3T[A-Z0-9]|AKIA|ASIA)[A-Z0-9]{16}'; then
  fail "an AWS access key id looks like it is being committed. Use a placeholder."
fi
if echo "$added" | grep -qiE 'aws_secret_access_key[[:space:]]*[=:][[:space:]]*[A-Za-z0-9/+]{40}'; then
  fail "an AWS secret access key looks like it is being committed."
fi
if echo "$added" | grep -qE 'npm_[A-Za-z0-9]{36}'; then
  fail "an npm token looks like it is being committed. Put it in your user ~/.npmrc, never here."
fi
if echo "$added" | grep -qE '_authToken[[:space:]]*=[[:space:]]*[^$][^[:space:]]{8,}'; then
  fail "an _authToken value looks like it is being committed. Reference it as \${NPM_TOKEN} instead."
fi

# --- 2. Commits have to be signed ---------------------------------------------
# main rejects unsigned commits, so without this the news arrives at merge time.
# A pre-commit hook cannot inspect a signature that does not exist yet, so it
# checks that signing is configured; pre-push checks the commits themselves.

if [ "$(git config --get commit.gpgsign)" != "true" ]; then
  fail "commit signing is off, and main requires signed commits.
    git config commit.gpgsign true
    git config rebase.gpgsign true
  No key yet? SSH signing is the shortest route:
    git config gpg.format ssh
    git config user.signingkey ~/.ssh/id_ed25519.pub
  then add that public key to https://github.com/settings/keys a second time,
  as a signing key."
fi

if [ -z "$(git config --get user.signingkey)" ] && [ "$(git config --get gpg.format)" != "ssh" ]; then
  fail "commit.gpgsign is on but user.signingkey is unset, so the commit will fail to sign."
fi

if [ "$(git config --get rebase.gpgsign)" != "true" ]; then
  echo "pre-commit: note — rebase.gpgsign is not set, so a rebase will unsign these commits." >&2
  echo "            git config rebase.gpgsign true" >&2
fi

# --- 3. The code and the dates have to work -----------------------------------
# retirements.yaml is data, but a malformed date in it silently turns a finding
# into "unknown", so it is tested like code.
if echo "$staged" | grep -qE '\.(js|json|ya?ml)$'; then
  echo "pre-commit: tests"
  npm test --silent
fi

# --- 4. A broken workflow file removes its own checks ------------------------
# A YAML error in .github/workflows does not fail CI. It fails the run before
# any job starts, so the required checks never report and the pull request sits
# there looking fine.
if echo "$staged" | grep -qE '^\.github/.*\.ya?ml$'; then
  echo "pre-commit: workflow yaml"
  for f in $(echo "$staged" | grep -E '^\.github/.*\.ya?ml$'); do
    [ -f "$f" ] || continue
    node -e "require('yaml').parse(require('fs').readFileSync(process.argv[1],'utf8'))" "$f" || {
      echo "pre-commit: $f is not valid YAML. CI would not run at all." >&2
      exit 1
    }
  done
fi

exit 0
